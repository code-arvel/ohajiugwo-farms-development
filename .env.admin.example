# Copy to .env.admin locally. Never paste actual values into chat or commit that file.
# Hosted disposable development only. Do not use a production Supabase project.
ADMIN_ENVIRONMENT=hosted-development
ADMIN_ORIGIN=http://127.0.0.1:4322
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Random 32-byte hex key, generated locally and kept in your password manager.
ADMIN_SESSION_KEY=
# Optional NEW gates; leave unset until reviewed migrations 015/016 and hosted checks pass.
# ADMIN_ENABLE_SESSION_RECONCILIATION=confirmed-development-only
# ADMIN_ENABLE_ACCOUNT_EMAIL_DELIVERY=confirmed-development-only
# Email delivery also requires existing account lifecycle/invitation/recovery gates,
# verified provider templates, and approval for the specific real recipient/action.
